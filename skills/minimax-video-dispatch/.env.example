# Minimax 官方平台
MINIMAX_OFFICIAL_API_KEY=your_official_api_key
MINIMAX_OFFICIAL_BASE_URL=https://api.minimaxi.com

# 秘塔中转站
# 支持配置多个 API Key，每个 Key 的并发上限为 4
# 使用时通过 --metaso-key 指定具体环境变量名，例如 METASO_API_KEY_1
METASO_API_KEY=your_metaso_api_key
METASO_API_KEY_1=your_metaso_api_key_1
METASO_API_KEY_2=your_metaso_api_key_2
METASO_API_KEY_3=your_metaso_api_key_3
METASO_BASE_URL=https://metaso.cn/api/minimax

# 默认平台（official / metaso）
DEFAULT_VIDEO_PLATFORM=official

# 产物保存根目录
OUTPUT_BASE_DIR=04_支线产出/产出

# 清单目录
MANIFEST_DIR=00_元数据/清单
